void render( int num){

  byte smbl;

  if(num == 0){ smbl = 0b00000000;}
   if ( num == 1){ smbl = 0b10000000;}
   if ( num == 2){ smbl = 0b11000000;}
   if ( num == 3){ smbl = 0b11100000;}
   if ( num == 4){ smbl = 0b11110000;}
   if ( num == 5){ smbl = 0b11111000;}
   if ( num == 6){ smbl = 0b11111100;}
   if ( num == 7){ smbl = 0b11111111;}
   if ( num == 8){ smbl =  0b11111111;}
   if ( num == 9) { smbl = 0b11111111;}
   else{smbl == 0b00000000;}

   digitalWrite(10 , LOW);
   shiftOut(12  , 11  , LSBFIRST  , smbl);
   digitalWrite(10 , HIGH);

}

